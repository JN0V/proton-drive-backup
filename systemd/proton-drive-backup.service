[Unit]
Description=Back up a local folder to Proton Drive
Documentation=https://proton.me/support/drive-cli
# Ordering only, and only at boot: this is a user unit, so the target is the
# user manager's own, and nothing here delays a run started on resume — when
# the timer catches up on a missed deadline the wifi is usually still coming
# back. Waiting for the network is therefore the script's job, not systemd's:
# it retries the session probe instead of mistaking an unreachable API for an
# expired session.
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/bin/proton-drive-backup.sh
# Transfers can be long; cut off after 2h rather than hanging forever
TimeoutStartSec=7200
