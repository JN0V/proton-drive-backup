[Unit]
Description=Back up ~/Documents/drive to Proton Drive
Documentation=https://proton.me/support/drive-cli
# Do not start without usable networking
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/bin/proton-drive-backup.sh
# Transfers can be long; cut off after 2h rather than hanging forever
TimeoutStartSec=7200
