[Unit]
Description=Sauvegarde de ~/Documents/drive vers Proton Drive
Documentation=https://proton.me/support/drive-cli
# On ne demarre pas sans reseau utilisable
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/bin/proton-drive-backup.sh
# Le transfert peut etre long ; on coupe au bout de 2h plutot que de rester bloque
TimeoutStartSec=7200
