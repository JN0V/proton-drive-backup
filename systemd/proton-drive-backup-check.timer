[Unit]
Description=Daily staleness watch for the Proton Drive backup

[Timer]
# 13:00, one hour after the backup window: gives it time to finish before its
# result is judged.
OnCalendar=*-*-* 13:00:00

# Same reasoning as the backup timer: if the machine was off, the check runs on
# return rather than being skipped.
Persistent=true

RandomizedDelaySec=5min
AccuracySec=1min

[Install]
WantedBy=timers.target
