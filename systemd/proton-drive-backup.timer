[Unit]
Description=Daily Proton Drive backup (12:00, catches up if missed)

[Timer]
# Every day at 12:00
OnCalendar=*-*-* 12:00:00

# The key setting: if the deadline was missed because the machine was off or
# the session was closed, systemd fires the service as soon as possible instead
# of waiting for the next day. This is what covers "off at 12:00, powered on at
# 15:00". The last-trigger timestamp is kept in ~/.local/share/systemd/timers/
# and therefore survives reboots.
Persistent=true

# Spread the trigger over 5 minutes. This applies to the catch-up too, which
# keeps the confirmation dialog from popping up mid-login.
RandomizedDelaySec=5min

# Coalescing tolerance; 1 min is plenty and avoids waking the machine more
# often than necessary.
AccuracySec=1min

[Install]
WantedBy=timers.target
