# Proton Drive backup host settings
# =============================================================================
#
# Everything that differs from one machine to the next. Every line is optional:
# left commented out, the default applies, which is the desktop behaviour.
#
# Format: KEY=value, one per line. Not a shell script: nothing is expanded
# except a leading ~/ . Quotes around the value are optional; unquoted, " #"
# starts a comment.
#
# Any key can be overridden for a single run from the environment, prefixed
# with PROTON_DRIVE_BACKUP_ :
#   PROTON_DRIVE_BACKUP_SOURCE_ROOT=/tmp/test proton-drive-backup.sh --dry-run
# =============================================================================


# --- Source ------------------------------------------------------------------
# Local folder whose subfolders are matched against mappings.conf. Absolute
# (or ~/...). A source with nothing in it at all is reported as an error: on a
# server, that is what an unmounted disk looks like.
#
# SOURCE_ROOT=~/Documents/drive


# --- Notifications -----------------------------------------------------------
# Space-separated list of: desktop (notify-send), command, none.
# A host without a graphical session has nobody to show a desktop notification
# to: use a command there.
#
# NOTIFY=desktop

# Executable called as: COMMAND URGENCY TITLE BODY, URGENCY being low, normal
# or critical, exit status 0 meaning delivered. An absolute path (or ~/...) to
# an executable file, no arguments. It can reach any service;
# examples/notify-ntfy.sh in the repository is one.
#
# NOTIFY_COMMAND=~/bin/notify-ntfy.sh
